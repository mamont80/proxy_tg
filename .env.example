# Скопировать в .env рядом с docker-compose.yml и подставить свои значения.
# Файл .env в git не попадает (см. .gitignore), права стоит выставить в 600.
#
# api_id / api_hash получаются на https://my.telegram.org -> API development tools.
# Это учётные данные ПРИЛОЖЕНИЯ, а не бота: они не связаны с токеном бота
# и одна пара обслуживает всех ботов на этом Bot API Server.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
